# Application
APP_NAME=InsureSearch
APP_ENV=development
LOG_LEVEL=INFO

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=1024

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=insurance_documents
QDRANT_API_KEY=

# Document chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
SEARCH_TOP_K=10